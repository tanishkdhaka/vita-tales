[Unit]
Description=Next.js Biography & Success Stories Publishing Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/biography
ExecStart=/usr/bin/node .next/standalone/server.js

# Environment Configuration
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/var/www/biography/.env.production

# Restart Policy
Restart=always
RestartSec=5s

# Process Sandboxing & Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/biography/data /var/www/biography/public/uploads

# Resource Limits
LimitNOFILE=65536
KillMode=process

[Install]
WantedBy=multi-user.target
